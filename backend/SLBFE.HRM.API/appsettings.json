{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=SLBFE_HRM_DB;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True;",
    "HangfireConnection": "Server=localhost;Database=SLBFE_HRM_Hangfire;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "JwtSettings": {
    "SecretKey": "SLBFE-HRM-Secret-Key-2025-Change-This-In-Production-Min-256-Bits",
    "Issuer": "SLBFE-HRM-API",
    "Audience": "SLBFE-HRM-Client",
    "ExpirationMinutes": 480
  },
  "CORS": {
    "AllowedOrigins": [ "*" ]
  },
  "FileStorage": {
    "BasePath": "C:\\SLBFE\\HRM\\Files",
    "MaxFileSizeMB": 10,
    "AllowedExtensions": [ ".pdf", ".doc", ".docx", ".xls", ".xlsx", ".jpg", ".jpeg", ".png" ]
  },
  "Email": {
    "SmtpServer": "smtp.slbfe.lk",
    "SmtpPort": 587,
    "EnableSsl": true,
    "FromEmail": "noreply@slbfe.lk",
    "FromName": "SLBFE HRM System"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "fileSizeLimitBytes": 10485760,
          "rollOnFileSizeLimit": true,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "ApplicationSettings": {
    "ApplicationName": "SLBFE HRM System",
    "Version": "1.0.0",
    "EnableSwagger": true,
    "EnableDetailedErrors": false,
    "SessionTimeoutMinutes": 30,
    "PasswordPolicy": {
      "MinimumLength": 8,
      "RequireUppercase": true,
      "RequireLowercase": true,
      "RequireDigit": true,
      "RequireSpecialCharacter": true
    }
  },
  "BackupSettings": {
    "BackupPath": "D:\\Backups\\SLBFE_HRM",
    "RetentionDays": 90,
    "FullBackupSchedule": "0 2 * * *",
    "DifferentialBackupSchedule": "0 */6 * * *"
  },
  "PerformanceSettings": {
    "EnableResponseCaching": true,
    "CacheDurationSeconds": 60,
    "EnableResponseCompression": true,
    "MaxConcurrentRequests": 100,
    "RequestTimeoutSeconds": 300
  }
}
