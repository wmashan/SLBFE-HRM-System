{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Error"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=YOUR_PRODUCTION_SERVER;Database=SLBFE_HRM_DB;User Id=hrm_user;Password=CHANGE_THIS_PASSWORD;MultipleActiveResultSets=true;TrustServerCertificate=False;Encrypt=True;Connection Timeout=30;Min Pool Size=5;Max Pool Size=100;",
    "HangfireConnection": "Server=YOUR_PRODUCTION_SERVER;Database=SLBFE_HRM_Hangfire;User Id=hangfire_user;Password=CHANGE_THIS_PASSWORD;TrustServerCertificate=False;Encrypt=True;"
  },
  "JwtSettings": {
    "SecretKey": "CHANGE_THIS_TO_SECURE_RANDOM_KEY_MIN_256_BITS_IN_PRODUCTION",
    "Issuer": "https://hrm-api.slbfe.lk",
    "Audience": "https://hrm.slbfe.lk",
    "ExpirationMinutes": 480
  },
  "CORS": {
    "AllowedOrigins": [
      "https://hrm.slbfe.lk",
      "https://www.slbfe.lk"
    ]
  },
  "FileStorage": {
    "BasePath": "D:\\SLBFE\\HRM\\Files",
    "MaxFileSizeMB": 10,
    "AllowedExtensions": [ ".pdf", ".doc", ".docx", ".xls", ".xlsx", ".jpg", ".jpeg", ".png" ]
  },
  "Email": {
    "SmtpServer": "smtp.slbfe.lk",
    "SmtpPort": 587,
    "EnableSsl": true,
    "Username": "noreply@slbfe.lk",
    "Password": "CHANGE_THIS_PASSWORD",
    "FromEmail": "noreply@slbfe.lk",
    "FromName": "SLBFE HRM System"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Error",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Error"
      }
    }
  },
  "ApplicationSettings": {
    "EnableSwagger": false,
    "EnableDetailedErrors": false,
    "SessionTimeoutMinutes": 30
  },
  "BackupSettings": {
    "BackupPath": "D:\\Backups\\SLBFE_HRM",
    "RetentionDays": 90,
    "FullBackupSchedule": "0 2 * * *",
    "DifferentialBackupSchedule": "0 */6 * * *"
  },
  "PerformanceSettings": {
    "EnableResponseCaching": true,
    "CacheDurationSeconds": 300,
    "EnableResponseCompression": true,
    "MaxConcurrentRequests": 200,
    "RequestTimeoutSeconds": 300
  }
}
